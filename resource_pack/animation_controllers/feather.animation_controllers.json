{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.feather.editor": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {
                            "flying": "!query.is_on_ground"
                        }
                    ]
                },
                "flying": {
                    "animations": [
                        "fly"
                    ],
                    "transitions": [
                        {
                            "default": "query.is_on_ground"
                        }
                    ]
                }
            }
        }
    }
}